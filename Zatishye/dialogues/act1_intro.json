{
  "lines": [
    {
      "speaker": "Санин",
      "text": "Паром качает. Голова раскалывается..."
    },
    {
      "speaker": "Стас",
      "text": "Держись, маршал. Скоро на месте."
    },
    {
      "speaker": "Санин",
      "text": "Ты новенький? Откуда?"
    },
    {
      "speaker": "Стас",
      "text": "Служил в Тихоморске, штат Озёрный."
    }
  ]
}